; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RPG Pixel Art Dark Fantasy"
config/description="RPG de mundo abierto en primera persona, vertical, pixel art."
config/version="0.1.0"
run/main_scene="res://world/world.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
config/project_settings_override="user://renderer_override.cfg"

[autoload]

Graphics="*res://core/graphics/graphics.gd"
Sfx="*res://core/sfx.gd"
Piedra="*res://piedra/piedra.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[navigation]

; Los mapas de navegación de zonas grandes (la Hondonada) nunca terminaban de
; armarse en segundo plano en las pruebas sin pantalla. Armado directo: cuesta
; un instante al cargar la zona y siempre funciona.
world/region_use_async_iterations=false

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
